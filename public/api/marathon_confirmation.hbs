<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{eventName}} – You Are Registered</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f7f8fb;
        font-family: Arial, "Helvetica Neue", sans-serif;
        color: #0b1c3d;
      }
      .outer {
        width: 100%;
        background: #f7f8fb;
        padding: 0;
      }
      .hero-bar {
        background: #072a5c;
        color: #ffffff;
        padding: 32px 20px 28px;
        text-align: center;
      }
      .logo {
        max-width: 180px;
        margin: 0 auto 16px;
        display: block;
      }
      .kicker {
        font-size: 16px;
        letter-spacing: 0.08em;
        margin: 0 0 8px;
      }
      .hero-title {
        font-size: 32px;
        font-weight: 800;
        letter-spacing: 0.02em;
        margin: 0;
      }
      .body {
        background: #ffffff;
        max-width: 720px;
        margin: 0 auto;
        padding: 32px 28px 40px;
        box-sizing: border-box;
      }
      .body p {
        font-size: 15px;
        line-height: 1.6;
        margin: 0 0 16px;
        color: #0b1c3d;
      }
      .body a {
        color: #0b4dc7;
      }
      .cta-row {
        margin: 28px 0 32px;
        display: block;
      }
      .badge-card {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        background: #072a5c;
        color: #ffffff;
        padding: 20px;
        border-radius: 8px;
        align-items: center;
      }
      .bib-img {
        width: 140px;
        height: auto;
        border-radius: 4px;
        background: #fff;
      }
      .share-block h3 {
        margin: 0 0 8px;
        font-size: 18px;
        font-weight: 800;
      }
      .share-block p {
        margin: 0;
        color: #dbe5ff;
        font-size: 14px;
      }
      .social-row {
        margin-top: 12px;
      }
      .social-icon {
        display: inline-block;
        margin-right: 10px;
        width: 28px;
        height: 28px;
        line-height: 28px;
        text-align: center;
        border-radius: 50%;
        background: #ffffff;
        color: #072a5c;
        font-weight: 700;
        text-decoration: none;
        font-size: 14px;
      }
      .section {
        margin: 28px 0;
      }
      .section h2 {
        margin: 0 0 12px;
        font-size: 18px;
        letter-spacing: 0.01em;
      }
      .section table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
        color: #2c3652;
      }
      .section td {
        padding: 8px 0;
      }
      .section td:first-child {
        font-weight: 700;
      }
      .section.total td {
        font-weight: 800;
        color: #c3142c;
      }
      .divider {
        border: 0;
        border-top: 1px solid #e3e6ed;
        margin: 24px 0;
      }
      .button {
        display: inline-block;
        background: #d4002a;
        color: #ffffff !important;
        text-decoration: none;
        padding: 12px 18px;
        border-radius: 4px;
        font-weight: 700;
        font-size: 14px;
      }
      .ticket-seller,
      .research {
        font-size: 14px;
        line-height: 1.5;
        color: #0b1c3d;
      }
      .footer {
        text-align: center;
        padding: 24px 12px 32px;
        font-size: 12px;
        color: #56627a;
      }
      .footer a {
        color: #0b4dc7;
      }
      @media (max-width: 640px) {
        .hero-title {
          font-size: 26px;
        }
        .body {
          padding: 24px 18px 32px;
        }
        .badge-card {
          text-align: center;
          justify-content: center;
        }
        .share-block {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <div class="outer">
      <div class="hero-bar">
        {{#if logoUrl}}
          <img class="logo" src="{{logoUrl}}" alt="{{eventName}} logo" />
        {{/if}}
        <div class="kicker">Congratulations, {{firstName}}</div>
        <div class="hero-title">You Are Registered</div>
      </div>

      <div class="body">
        <p>Hello {{firstName}},</p>
        <p>
          It’s fantastic you’re part of the {{eventName}} on {{eventDate}}!
          The race is great fun and a thrilling challenge — it also supports an incredible cause.
          {{causeLine}}
        </p>
        <p>
          You can download the app from
          <a href="{{appleAppLink}}">Apple</a> or
          <a href="{{googleAppLink}}">Google Play Store</a> and start training today.
        </p>
        <p>
          To make your training and race even more enjoyable, get your family and friends excited about the event, too.
          Because together, it’s even more fun.
        </p>
        <p>Thank you so much! See you soon,</p>
        <p>Your {{eventName}} team</p>

        <div class="cta-row">
          <div class="badge-card">
            {{#if bibImageUrl}}
              <img class="bib-img" src="{{bibImageUrl}}" alt="Bib {{bibNumber}}" />
            {{/if}}
            <div class="share-block">
              <h3>Share your start number</h3>
              <p>Start number: <strong>{{bibNumber}}</strong></p>
              <div class="social-row">
                {{#if shareFacebook}}<a class="social-icon" href="{{shareFacebook}}">f</a>{{/if}}
                {{#if shareTwitter}}<a class="social-icon" href="{{shareTwitter}}">x</a>{{/if}}
                {{#if shareInstagram}}<a class="social-icon" href="{{shareInstagram}}">ig</a>{{/if}}
              </div>
            </div>
          </div>
        </div>

        <div class="section">
          <h2>Entry Fee</h2>
          <table>
            <tr>
              <td>{{ticketName}}</td>
              <td align="right">{{ticketPrice}}</td>
            </tr>
            <tr>
              <td>{{discountLabel}}</td>
              <td align="right">{{discountAmount}}</td>
            </tr>
            <tr class="total">
              <td>Total</td>
              <td align="right">{{totalAmount}}</td>
            </tr>
          </table>
        </div>

        <hr class="divider" />

        <div class="section">
          <h2>Your Data</h2>
          <table>
            <tr>
              <td>Date of registration</td>
              <td align="right">{{registrationDate}}</td>
            </tr>
            <tr>
              <td>{{eventName}}</td>
              <td align="right">{{raceCategory}}</td>
            </tr>
            <tr>
              <td>Event date</td>
              <td align="right">{{eventDate}}</td>
            </tr>
          </table>
        </div>

        <hr class="divider" />

        <div class="section">
          <h2>Terms</h2>
          <p>You consent to the following policies and terms</p>
          <p>
            {{#if privacyLink}}<a href="{{privacyLink}}">Privacy Policy</a><br />{{/if}}
            {{#if termsLink}}<a href="{{termsLink}}">Terms of Participation</a><br />{{/if}}
            {{#if rulebookLink}}<a href="{{rulebookLink}}">Rulebook</a><br />{{/if}}
            {{#if disclaimerLink}}<a href="{{disclaimerLink}}">Disclaimer</a>{{/if}}
          </p>
        </div>

        <hr class="divider" />

        <div class="section">
          <h2>Need More Help?</h2>
          <p>
            For questions about registration or payment or if you need a receipt,
            contact us.
          </p>
          {{#if supportLink}}
          <a class="button" href="{{supportLink}}" target="_blank" rel="noopener">Get in touch</a>
          {{/if}}
        </div>

        <hr class="divider" />

        <div class="section ticket-seller">
          <strong>Ticket Seller</strong><br />
          {{ticketSeller}}
        </div>

        <div class="section research">
          <h2>{{researchHeadline}}</h2>
          <p>{{researchCopy}}</p>
          {{#if magazineLink}}
            <p>More insights can be found in our <a href="{{magazineLink}}">magazine</a>.</p>
          {{/if}}
          {{#if sponsorLogoUrl}}
            <p><img src="{{sponsorLogoUrl}}" alt="Sponsor" style="max-width:180px;" /></p>
          {{/if}}
          {{#if appCtaImageUrl}}
            <p><img src="{{appCtaImageUrl}}" alt="Download app" style="max-width:260px;" /></p>
          {{/if}}
          {{#if foundationUrl}}
            <p><a href="{{foundationUrl}}">{{foundationUrl}}</a></p>
          {{/if}}
          <div class="social-row">
            {{#if socialTiktok}}<a class="social-icon" href="{{socialTiktok}}">tt</a>{{/if}}
            {{#if socialFacebook}}<a class="social-icon" href="{{socialFacebook}}">f</a>{{/if}}
            {{#if socialInstagram}}<a class="social-icon" href="{{socialInstagram}}">ig</a>{{/if}}
            {{#if socialYoutube}}<a class="social-icon" href="{{socialYoutube}}">yt</a>{{/if}}
          </div>
        </div>
      </div>

      <div class="footer">
        {{#if imprintLink}}<a href="{{imprintLink}}">Imprint</a>{{/if}}<br />
        © {{eventYear}} {{eventName}}
      </div>
    </div>
  </body>
</html>
